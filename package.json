{
  "name": "knowforge",
  "description": "A local-first learning workbench for frontend, Python, web scraping, REST APIs, and AI engineering.",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json server/index.mjs --dev",
    "build:data": "node scripts/build-data.mjs",
    "build": "npm run build:data && vite build",
    "start": "node server/index.mjs",
    "package:deploy": "node scripts/package-deploy.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:data": "node scripts/check-data.mjs",
    "test:mysql": "TEST_MYSQL=1 node --test tests/mysql.test.mjs tests/api.test.mjs tests/auth.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.7",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.468.0",
    "marked": "^16.3.0",
    "mysql2": "^3.24.6",
    "prettier": "^3.9.10",
    "pyodide": "^314.0.7",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "vite": "^7.1.10"
  }
}

# Copy to .env in the project root. Keep credentials on the server only.
FRONTEND_PORT=16666
PORT=6666
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=knowforge
MYSQL_PASSWORD="replace-with-your-database-password"
MYSQL_DATABASE=knowforge
MYSQL_TABLE_PREFIX=knowforge_
# For remote MySQL with verified TLS, set true and optionally MYSQL_SSL_CA.
MYSQL_SSL=false
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
# To use SQLite instead: DB_DRIVER=sqlite and optionally DB_PATH=runtime/study.sqlite
